        compatibility: "5월 · 싱그러운 장미 향"
      },

      3: {
        name: "벚꽃 향",
        emoji: "🌸",
        reason: "새로운 시작을 알리는 봄처럼 산뜻하고 설레는 향이에요.<br>가볍고 깨끗한 꽃향이 봄의 생동감을 표현해줘요.",
        compatibility: "4월 · 프리지아 향"
      },

      4: {
        name: "프리지아 향",
        emoji: "💐",
        reason: "맑고 산뜻한 느낌이 가득한 향으로 봄과 잘 어울려요.<br>밝고 깨끗한 향기가 기분 좋은 설렘을 만들어줘요.",
        compatibility: "3월 · 벚꽃 향"
      },

      5: {
        name: "라일락 향",
        emoji: "🪻",
        reason: "따뜻하고 싱그러운 5월의 분위기를 담은 향이에요.<br>부드러운 꽃향과 은은한 달콤함이 편안한 매력을 보여줘요.",
        compatibility: "6월 · 은방울꽃 향"
      },

      6: {
        name: "은방울꽃 향",
        emoji: "🌱",
        reason: "초여름의 깨끗하고 청량한 공기를 떠올리게 하는 향이에요.<br>맑고 섬세한 향기가 싱그러운 분위기를 더해줘요.",
        compatibility: "4월 · 프리지아 향"
      },

      7: {
        name: "해바라기 향",
        emoji: "🌻",
        reason: "햇살이 강한 여름처럼 밝고 긍정적인 분위기가 느껴져요.<br>활기차고 따뜻한 이미지가 여름의 에너지와 잘 맞아요.",
        compatibility: "8월 · 플루메리아 향"
      },

      8: {
        name: "플루메리아 향",
        emoji: "🌺",
        reason: "여름 휴양지처럼 화사하고 이국적인 분위기를 가진 향이에요.<br>달콤하고 부드러운 꽃향이 여름의 여유로움을 표현해줘요.",
        compatibility: "7월 · 해바라기 향"
      },

      9: {
        name: "라벤더 향",
        emoji: "🪻",
        reason: "선선한 바람이 불기 시작하는 9월과 잘 어울리는 향이에요.<br>차분하고 편안한 향기가 마음을 부드럽게 감싸줘요.",
        compatibility: "1월 · 자스민 향"
      },

      10: {
        name: "금목서 향",
        emoji: "🌼",
