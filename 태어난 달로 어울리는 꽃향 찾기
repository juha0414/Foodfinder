        compatibility: "10월 · 금목서 향"
      },

      12: {
        name: "동백꽃 향",
        emoji: "🌺",
        reason: "차가운 겨울에도 피어나는 동백처럼 따뜻한 생명력이 느껴져요.<br>부드럽고 우아한 꽃향이 겨울의 신비로운 분위기를 살려줘요.",
        compatibility: "2월 · 장미 향"
      }
    };

    function showResult(month) {
      const data = scentData[month];

      document.getElementById("resultMonth").textContent =
        month + "월생에게 어울리는 향";

      document.getElementById("flowerEmoji").textContent =
        data.emoji;

      document.getElementById("scentName").textContent =
        data.name;

      document.getElementById("reason").innerHTML =
        data.reason;

      document.getElementById("compatibility").textContent =
        data.compatibility;

      document.getElementById("selectionCard").style.display = "none";

      const resultCard = document.getElementById("resultCard");
      resultCard.classList.add("show");

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    }

    function resetPage() {
      document.getElementById("resultCard").classList.remove("show");
      document.getElementById("selectionCard").style.display = "block";

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    }
  </script>

