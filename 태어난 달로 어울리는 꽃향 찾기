      </div>

      <div class="hint">✨ 마음이 끌리는 달을 선택해도 좋아요!</div>
    </section>

    <!-- 결과 -->
    <section class="card result" id="resultCard">

      <div class="result-month" id="resultMonth"></div>

      <div class="flower-emoji" id="flowerEmoji"></div>

      <h2 class="scent-name" id="scentName"></h2>

      <div class="scent-label">🌷 나에게 어울리는 꽃향</div>

      <div class="reason-box">
        <div class="reason-title">✨ 이 향이 어울리는 이유</div>
        <p class="reason" id="reason"></p>
      </div>

      <div class="compatibility">
        <div class="compatibility-title">
          💕 잘 맞는 다른 유형(궁합)
        </div>
        <div class="compatibility-value" id="compatibility"></div>
      </div>

      <button class="reset-button" onclick="resetPage()">
        ↩ 다시 고르기
      </button>

    </section>

  </div>

  <script>
    const scentData = {
      1: {
        name: "자스민 향",
        emoji: "🌼",
        reason: "차분하고 포근한 겨울의 분위기와 잘 어울리는 향이에요.<br>은은하면서도 깊은 느낌이 있어 따뜻한 매력을 더해줘요.",
        compatibility: "9월 · 은은한 라벤더 향"
      },

      2: {
        name: "장미 향",
