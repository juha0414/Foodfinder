  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Malgun Gothic", "Apple SD Gothic Neo", sans-serif;
      background:
        radial-gradient(circle at 15% 15%, rgba(255,255,255,0.9) 0 5%, transparent 25%),
        radial-gradient(circle at 85% 10%, rgba(255,210,225,0.45), transparent 28%),
        linear-gradient(135deg, #fff7f3, #ffe9ef 48%, #f9e8f5);
      color: #5d4350;
      padding: 30px 16px 50px;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 28px;
    }

    .moon {
      font-size: 52px;
      margin-bottom: 8px;
      filter: drop-shadow(0 4px 8px rgba(130, 80, 110, 0.15));
    }

    h1 {
      margin: 0;
      font-size: clamp(30px, 6vw, 48px);
      color: #8c5873;
      letter-spacing: -2px;
    }

    .subtitle {
      margin: 12px 0 0;
      font-size: clamp(16px, 3vw, 21px);
      color: #8d707d;
      line-height: 1.6;
    }

    .card {
      background: rgba(255, 250, 249, 0.86);
      border: 1px solid rgba(255,255,255,0.9);
      border-radius: 28px;
      padding: 28px;
      box-shadow: 0 15px 40px rgba(128, 76, 105, 0.12);
      backdrop-filter: blur(8px);
      margin-bottom: 24px;
    }

    .section-title {
      text-align: center;
      font-size: clamp(20px, 4vw, 27px);
      font-weight: 800;
      color: #754d63;
      margin-bottom: 20px;
    }

    .month-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .month-button {
      border: none;
      border-radius: 18px;
      padding: 17px 8px;
      background: #fff;
      color: #765364;
      font-size: clamp(16px, 3vw, 20px);
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 5px 14px rgba(110, 68, 91, 0.08);
      transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }

    .month-button:hover {
      transform: translateY(-3px);
      background: #ffe3ec;
      box-shadow: 0 9px 20px rgba(110, 68, 91, 0.14);
    }

    .month-button:active {
      transform: translateY(0);
    }

    .result {
      display: none;
      text-align: center;
      animation: appear 0.5s ease;
    }

    .result.show {
      display: block;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .result-month {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 999px;
      background: #f8dbe7;
      color: #82546c;
      font-size: 17px;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .flower-emoji {
      font-size: clamp(80px, 18vw, 130px);
      line-height: 1;
      margin: 8px 0 18px;
      filter: drop-shadow(0 10px 15px rgba(110, 68, 91, 0.12));
    }

    .scent-name {
      margin: 0;
      font-size: clamp(30px, 7vw, 46px);
      color: #8b4e6e;
      letter-spacing: -1px;
    }

    .scent-label {
      display: inline-block;
      margin-top: 10px;
      font-size: 16px;
      color: #a17c8e;
      background: #fff0f4;
      border-radius: 999px;
      padding: 7px 13px;
    }

    .reason-box {
      margin: 24px auto;
      max-width: 680px;
      padding: 22px;
      border-radius: 20px;
      background: linear-gradient(135deg, #fff8f7, #fff0f5);
      border: 1px solid #f5dbe5;
    }

    .reason-title {
      font-size: 19px;
      font-weight: 800;
      color: #81566a;
      margin-bottom: 10px;
    }

    .reason {
      margin: 0;
      font-size: clamp(17px, 3vw, 21px);
      line-height: 1.75;
      color: #6c5360;
      word-break: keep-all;
    }

    .compatibility {
      max-width: 680px;
      margin: 0 auto 24px;
      padding: 18px 20px;
      border-radius: 18px;
      background: #f7e7f4;
    }

    .compatibility-title {
      font-size: 17px;
      color: #91647e;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .compatibility-value {
      font-size: clamp(21px, 4vw, 27px);
      color: #744d66;
      font-weight: 900;
    }

    .reset-button {
      border: none;
      border-radius: 999px;
      padding: 14px 28px;
      background: #b97999;
      color: white;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 7px 18px rgba(135, 76, 105, 0.2);
      transition: transform 0.18s ease, background 0.18s ease;
    }

    .reset-button:hover {
      transform: translateY(-2px);
      background: #a96688;
    }

    .hint {
      text-align: center;
      margin-top: 18px;
      color: #a38491;
      font-size: 14px;
    }

    @media (max-width: 650px) {
      body {
        padding: 20px 12px 35px;
      }

      .card {
        padding: 20px 15px;
        border-radius: 22px;
      }

      .month-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
      }

      .month-button {
        padding: 15px 5px;
      }
    }

    @media (max-width: 400px) {
      .month-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <header class="header">
      <div class="moon">🌙</div>
      <h1>태어난 달로 어울리는 향 찾기</h1>
